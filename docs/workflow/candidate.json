  "cards": [
    {
      "dot": "cyan",
      "title": "Execution contract",
      "items": [
        "Prepare and start never launch a model request; execution requires an explicit step or serial-loop action.",
        "Serial mode follows committed next_action / next_target; it pauses on stop or two consecutive committed no_progress results.",
        "One active action per run; no application-level retry or model fallback. Transport internals remain adapter-dependent."
      ]
    },
    {
      "dot": "amber",
      "title": "Recovery and continuation",
      "items": [
        "Budget limits, errors and human pause end execution. A pause aborts and waits for the active request outcome.",
        "Missing or partial usage is not zero. Unknown calls are not replayed. Proposed output can be archived again without a model call.",
        "Reconciliation of a proposed action uses its exact research receipt. A continuation creates a new prepared run and needs manual start again; a clean paused run can also be continued."
      ]
    },
    {
      "dot": "rose",
      "title": "Scientific boundary",
      "items": [
        "The parent accepts only valid Note / Obligation proposals for the frozen Problem, checking fresh premises and exact revisions.",
        "derive, check, revise, decompose and reconstruct are model actions. No Python, historical checker, paper retrieval or full proof execution occurs here.",
        "Blind reconstruction hides the target argument and its evidence; failure is inconclusive. Model critique, program pass and human acceptance remain separate.",
        "Source snapshot: 613b6bb (2026-11-03). This is implementation documentation, not evidence of mathematical performance."
      ]
    },
    {
      "dot": "slate",
      "title": "Per-step safeguards",
      "items": [
        "Manual start: No model call yet.",
        "Choose execution: Explicit user action.",
        "Fresh context: No silent truncation.",
        "Exact model: Context window checked.",
        "Reserve budget: Request + token limits.",
        "Stream model: Tools unavailable.",
        "Usage + proposal: Missing usage blocks calls.",
        "Parent validation: Notes + Obligations only.",
        "Research commit: Model authority only.",
        "Next action: Fresh context each turn.",
        "Pause / stop: Stop calls no model.",
        "Reconcile outcome: Exact receipt recovery.",
        "Prepare continuation: Parent rev + research head.",
        "Candidate records: No global proof claim.",
        "Human review: Dedicated review entry."
      ]
    }
  ]
