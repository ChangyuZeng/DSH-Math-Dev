# Source-only repository. Keep local research and acceptance artifacts private.
# New root files must be explicitly admitted here and reviewed before staging.
/*
!/.gitignore
!/AGENTS.md
!/PUBLICATION.md
!/package.json
!/README.md
!/NOTICE
!/LICENSE-STATUS.md
!/PROVENANCE.json
!/cordis.patch.yml
!/icon.svg
!/project-fields.json
!/project-form.cjs
!/workbench-ui.cjs
!/materials-ui.cjs
!/material_store.py
!/material_extract.mjs
!/chat_research.py
!/workbench_store.py
!/preparation_tools.py
!/chat-tools.mjs
!/math-preview.cjs
!/pnpm-lock.yaml
!/THIRD-PARTY-NOTICES.txt
!/human-api.mjs
!/host.mjs
!/live_plugin.mjs
!/live_runner.mjs
!/run_control.py
!/client.js
!/client-main.cjs
!/client-theme.cjs
!/forms.cjs
!/form-ui.cjs
!/record-ui.cjs
!/comparison-ui.cjs
!/process-graph.cjs
!/graph-ui.cjs
!/build.mjs
!/backend.py
!/model_tools.py
!/m_runner.py
!/run_ledger.py
!/run_closeout.py
!/run_recovery.py
!/isolated_tools.py
!/schema.py
!/bundle.py
!/replay.py
!/runtime_cli.py
!/verify_bundle.py
!/grid75_independent_check.py
!/audit-reader.mjs

!/locale/
/locale/*
!/locale/*.json

!/runtime/
/runtime/*
!/runtime/p2c/
/runtime/p2c/*
!/runtime/p2c/*.py
!/runtime/p2c/checkers/
/runtime/p2c/checkers/*
!/runtime/p2c/checkers/*.py

!/contracts/
/contracts/*
!/contracts/*.json
!/contracts/workbench-v1.md
!/contracts/cards/
/contracts/cards/*
!/contracts/cards/*.md

# Only tests used by the current npm test entry point.
# Historical acceptance/profile scripts remain local and unchanged.
!/tests/
/tests/*
!/tests/run.mjs
!/tests/*.test.mjs
!/tests/test*.py

# Defense in depth, including inside admitted source directories.
node_modules/
__pycache__/
*.py[cod]
.DS_Store
._*
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.tgz
*.zip
*.jsonl
