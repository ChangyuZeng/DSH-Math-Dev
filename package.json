    "locale/*.json",
    "icon.svg",
    "host.mjs",
    "live_plugin.mjs",
    "live_runner.mjs",
    "run_control.py",
    "client.js",
    "client-main.cjs",
    "client-theme.cjs",
    "forms.cjs",
    "form-ui.cjs",
    "record-ui.cjs",
    "comparison-ui.cjs",
