    "bundle.py",
    "replay.py",
    "runtime_cli.py",
    "verify_bundle.py",
    "grid75_independent_check.py",
    "audit-reader.mjs",
    "runtime/p2c/*.py",
    "runtime/p2c/checkers/*.py",
    "contracts/*.json",
    "contracts/cards/*.md",
    "cordis.patch.yml",
    "PROVENANCE.json",
    "NOTICE",
    "LICENSE-STATUS.md",
    "PUBLICATION.md",
    "README.md"
  ],
  "private": true,
  "type": "module",
  "main": "host.mjs",
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    ".": "./host.mjs",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "katex": "0.19.1",
    "marked": "18.1.2"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "node build.mjs",
    "test": "node tests/run.mjs",
    "prepack": "node build.mjs"
  },
  "dependencies": {
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299"
  }
}
