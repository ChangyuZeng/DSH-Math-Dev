    "project_access.py",
    "project-access-ui.cjs",
    "research-graph.cjs",
    "research-graph-ui.cjs",
    "research-graph-theme.cjs",
    "workbench_store.py",
    "preparation_tools.py",
    "chat-tools.mjs",
    "math-preview.cjs",
    "THIRD-PARTY-NOTICES.txt",
